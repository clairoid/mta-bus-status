    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "7.18.2",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
