# Copy to .env and fill in. Only MTA_BUSTIME_KEY is required to run the app;
# without the Supabase/VAPID values it runs anonymously with push disabled.
# See the README for what each one does.

# --- Server-side (never sent to the browser) ---------------------------------
MTA_BUSTIME_KEY=

# Supabase — service role key bypasses RLS, keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Gates GET /api/push. The endpoint fails closed if this is unset.
CRON_SECRET=

# --- Client-side (compiled into the bundle — treat as public) ----------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use a public (pk.) Mapbox token with a URL restriction.
VITE_MAPBOX_TOKEN=

# Same value as VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=
